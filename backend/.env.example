# ============================================
# VoxMind — Backend Environment Config
# ============================================

# Server
PORT=
NODE_ENV=

# Google Gemini API (PRIMARY AI ENGINE)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude API (fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Hybrid AI router
AI_ROUTER_MODE=hybrid
AI_CIRCUIT_FAILURE_LIMIT=3
AI_CIRCUIT_RESET_MS=60000

# OpenAI API (Whisper STT + embeddings)
OPENAI_API_KEY=
ALLOW_STUB_TRANSCRIPTION=false

# ElevenLabs API (premium TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Database (Postgres + pgvector)
DATABASE_URL=
VOICEAI_MEMORY_MODE=local

# Cache (Redis)
REDIS_URL=

# CORS
CORS_ORIGIN=

# Socket.IO
SOCKET_PATH=

# ── MCP Connector Credentials ──

CONNECTOR_DEMO_MODE=true

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Home Assistant
HA_BASE_URL=
HA_TOKEN=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Search
BRAVE_API_KEY=

# Finance
ALPHA_VANTAGE_KEY=

# Translation
DEEPL_KEY=

# Travel
AMADEUS_KEY=
AMADEUS_SECRET=

# JWT
JWT_SECRET=

# Local computer access for desktop/employee mode.
# Use path delimiter for multiple roots: ; on Windows, : on macOS/Linux.
# Example Windows: LOCAL_ACCESS_ROOTS=C:\Users\you\Projects;D:\Work
# Example macOS/Linux: LOCAL_ACCESS_ROOTS=/Users/you/Projects:/tmp/voiceai
LOCAL_COMPUTER_ACCESS=false
LOCAL_COMPUTER_WRITE=false
LOCAL_ACCESS_ROOTS=
