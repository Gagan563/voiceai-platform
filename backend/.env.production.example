# ==============================================================
# NOVA Voice AI Platform — Production Environment Configuration
# ==============================================================
#
# Copy this file to .env or backend/.env and update all secret values.
# NEVER commit your real .env file with production secrets to git!

# ── Server & Runtime ──
PORT=3001
NODE_ENV=production
APP_VERSION=2.0.0
TRUST_PROXY=1
LOG_LEVEL=info

# ── Security & Authentication ──
# CRITICAL: Generate a cryptographically secure 64+ char random string
# Example generation in bash: openssl rand -base64 48
JWT_SECRET=replace-with-a-secure-random-64-character-secret-key-here
JWT_EXPIRY_SECONDS=86400

# ── CORS Origins ──
# Comma-separated list of allowed origins
CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# ── Database ──
DATABASE_URL=postgresql://nova_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/nova_db
# Set to "local" if running without Postgres (uses data/memories.json)
VOICEAI_MEMORY_MODE=

# ── Redis Cache & Queues ──
REDIS_URL=redis://redis:6379

# ── Rate Limiting (Requests per Window) ──
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_AGENT_MAX=10
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GENERAL_MAX=120

# ── Primary AI Engines (At least one recommended) ──
# Google Gemini (Recommended — high quality, vision, free tier available)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (Fast & affordable cloud provider)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude (Premium reasoning)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# AI Router Strategy: hybrid, groq, gemini, anthropic
AI_ROUTER_MODE=hybrid

# ── Speech-to-Text (STT) ──
# OpenAI Whisper for server-side audio transcription
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=gpt-4o-mini-transcribe
OPENAI_WHISPER_LANGUAGE=en
ALLOW_STUB_TRANSCRIPTION=false

# ── Text-to-Speech (TTS) ──
# ElevenLabs for premium voice output (browser speech synthesis is used if empty)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── MCP Connector Integrations (Optional) ──
CONNECTOR_DEMO_MODE=false

# Google Calendar & Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Home Assistant (Local smart home)
HA_BASE_URL=
HA_TOKEN=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Brave Web Search
BRAVE_API_KEY=

# Alpha Vantage (Stock & Financial Quotes)
ALPHA_VANTAGE_KEY=

# DeepL / Translation
DEEPL_KEY=

# ── Safety & Content Filtering ──
CONTENT_MODERATION_ENABLED=true
PARENTAL_CONTROLS_ENABLED=false
PARENTAL_CONTROLS_AGE_GROUP=adult
VAD_SILENCE_TIMEOUT_MS=2000
