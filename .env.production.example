# ==============================================================
# NOVA Voice AI Platform — Production Environment Configuration
# ==============================================================
#
# Copy this file to .env and backend/.env and update all values.

# ── Server & Port ──
PORT=3001
NODE_ENV=production
APP_VERSION=2.0.0
TRUST_PROXY=1
LOG_LEVEL=info

# ── Security & Authentication ──
JWT_SECRET=replace-with-a-secure-random-64-character-secret-key-here
JWT_EXPIRY_SECONDS=86400

# ── CORS ──
CORS_ORIGIN=https://yourdomain.com

# ── Database & Cache (Docker Services) ──
POSTGRES_DB=nova_db
POSTGRES_USER=nova_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_POSTGRES_PASSWORD
DATABASE_URL=postgresql://nova_user:CHANGE_ME_TO_A_SECURE_POSTGRES_PASSWORD@postgres:5432/nova_db
REDIS_URL=redis://redis:6379

# ── AI Providers ──
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

AI_ROUTER_MODE=hybrid
ALLOW_STUB_TRANSCRIPTION=false
CONNECTOR_DEMO_MODE=false
